# env.example — copy to .env and fill in your values.
# Never commit .env or any file with real secrets.

# Agent Mode Configuration
SQL_AGENT_MODE=multi
SQL_AGENT_MODE_DEFAULT=multi

# LLM Provider Defaults
LLM_PROVIDER_DEFAULT=ollama
LLM_MODEL_DEFAULT=

# Enterprise LLM Configuration (leave blank to disable)
ENTERPRISE_LLM_PROVIDER=
ENTERPRISE_LLM_MODELS=
ENTERPRISE_LLM_API_KEY=your_enterprise_api_key_here
ENTERPRISE_LLM_ENDPOINT=

# Custom HTTP LLM Provider Configuration
CUSTOM_LLM_API_BASE=https://xxxx/ModelGateway/v1/chat/completions
CUSTOM_LLM_API_KEY=your_custom_api_key_here
CUSTOM_LLM_MODEL_DEFAULT=chat-model

# Local Ollama (required even with enterprise — used by CrewAI internals)
OPENAI_API_KEY=NA
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL_NAME=sqlcoder:7b
