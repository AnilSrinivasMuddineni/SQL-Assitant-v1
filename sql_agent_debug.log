DEFAULT CURRENT_TIMESTAMP, \n\tupdated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP, \n\tCONSTRAINT orders_pkey PRIMARY KEY (id), \n\tCONSTRAINT orders_user_id_fkey FOREIGN KEY(user_id) REFERENCES gen_ai.users (id)\n)\n\nCREATE TABLE gen_ai.users (\n\tid SERIAL NOT NULL, \n\tname VARCHAR(100) NOT NULL, \n\temail VARCHAR(100) NOT NULL, \n\tcreated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP, \n\tupdated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP, \n\tstatus VARCHAR(20) DEFAULT \'active\'::character varying, \n\tCONSTRAINT users_pkey PRIMARY KEY (id), \n\tCONSTRAINT users_email_key UNIQUE NULLS DISTINCT (email)\n)\n\nCREATE TABLE gen_ai.feedback (\n\tid SERIAL NOT NULL, \n\tnatural_language_query TEXT, \n\tgenerated_sql TEXT, \n\trating VARCHAR(10), \n\tcreated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP, \n\tCONSTRAINT feedback_pkey PRIMARY KEY (id)\n)\n                \n                Instructions:\n                1. Return ONLY the SQL query.\n                2. Do not include explanations or markdown formatting if possible.\n                3. Ensure valid PostgreSQL syntax.\n                4. Handle aggregations and GROUP BY clauses correctly.\n                5. Use HAVING for filtering on aggregated values (e.g. count > X).\n                \n                SQL Query:\n\nThis is the expected criteria for your final answer: PostgreSQL SQL query\nyou MUST return the actual complete content as the final answer, not a summary.\n\nThis is the context you\'re working with:\n### System:\n                {\n                    "entities": ["gen_ai.orders", "gen_ai.order_items"],\n                    "operation": "SELECT",\n                    "filters": [],\n                    "aggregations": [],\n                    "sorting": []\n                }\n\n----------\n\n### User:\n                SELECT o.order_number, to_char(o.order_date,\'YYYY-MM-DD\') AS order_date, u.user_name, p.product_name FROM gen_ai.orders o JOIN users u ON o.user_id = u.id JOIN order_items oi ON o.id = oi.order_id JOIN products p ON oi.product_id = p.id;\n                SELECT p.product_name, COUNT(oi.product_id) AS number_of_orders FROM gen_ai.products p JOIN order_items oi ON p.id = oi.product_id GROUP BY p.product_name;\n\nBegin! This is VERY important to you, use the tools available and give your best Final Answer, your job depends on it!\n\nThought:\n\n', 'options': {'stop': ['\nObservation:']}, 'stream': False, 'images': []}'
