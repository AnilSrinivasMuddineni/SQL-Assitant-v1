{
  "logging": {
    "level": "DEBUG",
    "handlers": [
      "console",
      "file"
    ],
    "filename": "sql_agent_debug.log"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "database": "postgres",
    "username": "postgres",
    "password": "root",
    "schema": "gen_ai"
  },
  "ollama": {
    "base_url": "http://localhost:11434",
    "model": "ministral-3:14b-cloud"
  },
  "settings": {
    "temperature": 0.7,
    "max_tokens": 2048
  },
  "config_management": {
    "table_name": "gen_ai.sql_rag_configurations",
    "column_name": "table_name",
    "schema_name": "gen_ai"
  },
  "memory": {
    "chroma_path": "./chroma_db",
    "short_term_limit": 10,
    "long_term_days": 30,
    "enable_user_history": true
  }
}